# Copiar a .env y completar únicamente cuando se hayan confirmado los datos reales.
PORT=3000
PUBLIC_URL=http://localhost:3000

# Pasarela pendiente de elegir. El servidor incluye un adaptador opcional para Stripe.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=

# Coste de envío en céntimos y países admitidos (ejemplo de formato: ES,PT).
# Los precios del catálogo deben contener los impuestos aplicables.
SHIPPING_CENTS=
SHIPPING_COUNTRIES=

# Endpoint HTTPS de la empresa para recibir las consultas en formato JSON.
CONTACT_WEBHOOK_URL=
